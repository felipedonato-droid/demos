# OAuth-only (preferred). Do NOT commit real values.
ZENDESK_OAUTH_SUBDOMAIN=zenmotorcycle
ZENDESK_OAUTH_CLIENT_ID=cursor-cloud-agent-oauth
ZENDESK_OAUTH_CLIENT_SECRET=
ZENDESK_OAUTH_REFRESH_TOKEN=
ZENDESK_OAUTH_ACCESS_TOKEN=
ZENDESK_OAUTH_REDIRECT_URI=http://127.0.0.1:8787/callback
# Local files (gitignored) written by npm run oauth:
#   .oauth-client.json
#   .oauth-tokens.json
# Set to 1 only when you want disposable CREATE/UPDATE/DELETE smoke tests
ZENDESK_ALLOW_WRITES=0
